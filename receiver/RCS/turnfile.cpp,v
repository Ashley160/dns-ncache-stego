using namespace std;

int main(){
	ifstream txt("r_domain.txt");
	ofstream out("r_file.txt");
	string str;
	int index=0;
	int sum = 0;
	while(getline(txt, str)){
		stringstream ss(str);
		unsigned long long a;
		ss >> a;
		if( a/8 == index){
			sum += pow(2, a%8);
		}
		else{
			out << (char)sum;
			index ++;
			sum=0;
			sum += pow(2, a%8);
		}
	}
	out << (char)sum;
	txt.close();
	out.close();
}
